{
	"name": "@phaseo/factory",
	"version": "0.1.0",
	"description": "Phaseo Factory: a work queue for coding agents, powered by your own subscriptions.",
	"author": "Phaseo",
	"private": true,
	"type": "module",
	"main": "dist/main/index.mjs",
	"engines": {
		"node": "^22.13.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
		"build:main": "vite build --config vite.main.config.ts",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.renderer.config.ts",
		"start": "electron .",
		"screenshot": "pnpm run build && electron scripts/screenshot.mjs",
		"lint": "eslint src scripts vite.*.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rimraf dist",
		"package": "pnpm run build && node scripts/package.mjs"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.304",
		"@base-ui/react": "1.6.0",
		"@tanstack/react-virtual": "^3.14.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.17.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "^10.1.0",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@electron/asar": "4.3.1",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "^26.1.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "catalog:",
		"@vitejs/plugin-react": "6.1.1",
		"electron": "42.11.18",
		"eslint": "^10.8.1",
		"globals": "^17.12.0",
		"rcedit": "5.0.2",
		"rimraf": "^6.0.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.0"
	}
}
