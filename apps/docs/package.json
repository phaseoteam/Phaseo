{
	"name": "@phaseo/docs",
	"version": "1.1.0",
	"private": true,
	"scripts": {
		"dev": "mintlify dev --port 3101 --no-open",
		"build": "pnpm run skills:check && pnpm run og:check && pnpm run openapi:locales:check && pnpm run validate:locales && pnpm run translation:freshness:check && mintlify validate",
		"check:links": "mintlify broken-links",
		"og:sync": "node scripts/sync-og-images.mjs",
		"og:check": "node scripts/sync-og-images.mjs --check",
		"openapi:locales": "node scripts/generate-localized-openapi.mjs",
		"openapi:locales:check": "node scripts/generate-localized-openapi.mjs --check",
		"translation:freshness:init": "node scripts/translation-freshness.mjs init",
		"translation:freshness:check": "node scripts/translation-freshness.mjs check",
		"translation:freshness:record": "node scripts/translation-freshness.mjs record",
		"validate:locales": "node scripts/validate-locales.mjs",
		"skills:sync": "node ../../scripts/skills/sync.mjs",
		"skills:check": "node ../../scripts/skills/sync.mjs --check",
		"preview": "mintlify preview",
		"clean": "rimraf .mint"
	},
	"dependencies": {
		"mintlify": "4.2.577"
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
