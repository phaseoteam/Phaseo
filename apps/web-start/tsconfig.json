{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": false,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@/app/(auth)/*": ["./src/app/[locale]/(auth)/*"],
      "@/app/(dashboard)/*": ["./src/app/[locale]/(dashboard)/*", "./src/app/(dashboard)/*"],
      "@/app/(legal)/*": ["./src/app/[locale]/(legal)/*"],
      "@/*": ["./src/*"],
      "next/link": ["./src/compat/next-link.tsx"],
      "next/navigation": ["./src/compat/next-navigation.ts"],
      "next/image": ["./src/compat/next-image.tsx"],
      "next/dynamic": ["./src/compat/next-dynamic.tsx"],
      "next/script": ["./src/compat/next-script.tsx"],
      "next/server": ["./src/compat/next-server.ts"],
      "next/cache": ["./src/compat/next-cache.ts"],
      "next/headers": ["./src/compat/next-headers.ts"],
      "next/og": ["./src/compat/next-og.ts"],
      "next/font/google": ["./src/compat/next-font-google.ts"],
      "next/web-vitals": ["./src/compat/next-web-vitals.ts"],
      "next": ["./src/compat/next-types.ts"],
      "next-intl/server": ["./src/compat/next-intl-server.ts"],
      "next-intl": ["./src/compat/next-intl.tsx"],
      "next-navigation-guard": ["./src/compat/next-navigation-guard.tsx"],
      "next-mdx-remote/rsc": ["./src/compat/next-mdx-remote-rsc.ts"],
      "@vercel/analytics/react": ["./src/compat/noop-modules.tsx"],
      "nuqs/adapters/next/app": ["./node_modules/nuqs/adapters/tanstack-router.d.ts"],
      "flags/next": ["./src/compat/flags-next.ts"],
      "server-only": ["./src/compat/empty.ts"],
      "client-only": ["./src/compat/empty.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "build/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/proxy.ts", "src/i18n/request.ts", "src/app/global-not-found.tsx", "src/app/?locale?/layout.tsx", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"]
}
