{
  "expo": {
    "name": "Phaseo",
    "slug": "phaseo",
    "scheme": "phaseo",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/phaseo-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.phaseo.client"
    },
    "android": {
      "package": "app.phaseo.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/phaseo-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/phaseo-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/phaseo-wordmark-dark.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#09090b",
            "image": "./assets/phaseo-wordmark-light.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "defaultChannel": "model-releases"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "phaseoOrigin": "https://phaseo.app",
      "phaseoApiOrigin": "https://api.phaseo.app/v1"
    }
  }
}
