{
  "expo": {
    "name": "Phaseo",
    "slug": "phaseo",
    "scheme": "phaseo",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/phaseo-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.phaseo.client"
    },
    "android": {
      "package": "app.phaseo.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/phaseo-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/phaseo-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/phaseo-wordmark-dark.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#09090b",
            "image": "./assets/phaseo-wordmark-light.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Montserrat",
                "fontDefinitions": [
                  { "path": "./assets/Montserrat-Regular.ttf", "weight": 400 },
                  { "path": "./assets/Montserrat-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/Montserrat-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/Montserrat-Regular.ttf",
              "./assets/Montserrat-SemiBold.ttf",
              "./assets/Montserrat-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "defaultChannel": "model-updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Phaseo uses your photos when you attach them to a chat.",
          "cameraPermission": "Phaseo uses the camera when you take a photo to attach to a chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "phaseoOrigin": "https://phaseo.app",
      "phaseoApiOrigin": "https://api.phaseo.app"
    }
  }
}
