{
	"name": "@phaseo/desktop",
	"version": "0.1.0",
	"description": "The Phaseo workspace for humans and agents.",
	"author": "Phaseo",
	"private": true,
	"type": "module",
	"main": "dist/main/index.mjs",
	"engines": {
		"node": "^22.13.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
		"build:main": "vite build --config vite.main.config.ts",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.renderer.config.ts",
		"start": "electron .",
		"package": "pnpm run build && electron-forge make",
		"package:dir": "pnpm run build && electron-forge package",
		"lint": "eslint src vite.*.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rimraf dist release"
	},
	"devDependencies": {
		"@electron-forge/cli": "7.11.2",
		"@electron-forge/maker-deb": "7.11.2",
		"@electron-forge/maker-dmg": "7.11.2",
		"@electron-forge/maker-msix": "7.11.2",
		"@electron-forge/maker-zip": "7.11.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.3.5",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"electron": "42.7.1",
		"eslint": "^10.8.1",
		"globals": "^17.9.0",
		"lucide-react": "^1.17.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"rimraf": "^6.0.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.0"
	},
	"config": { "forge": "./forge.config.cjs" }
}
