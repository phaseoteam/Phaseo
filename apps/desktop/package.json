{
	"name": "@phaseo/desktop",
	"version": "0.1.0",
	"description": "The Phaseo workspace for humans and agents.",
	"author": "Phaseo",
	"private": true,
	"type": "module",
	"main": "dist/main/index.mjs",
	"engines": {
		"node": "^22.13.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "pnpm --filter @phaseo/agent-sdk... build && pnpm run build:main && pnpm run build:preload && pnpm run build:renderer && node scripts/notices.mjs",
		"build:main": "vite build --config vite.main.config.ts",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.renderer.config.ts",
		"start": "electron .",
		"package": "pnpm run build && electron-forge make",
		"package:dir": "pnpm run build && electron-forge package",
		"lint": "eslint src vite.*.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:desktop": "pnpm run build && electron scripts/smoke.mjs",
		"clean": "rimraf dist release"
	},
	"devDependencies": {
		"@electron-forge/cli": "7.11.2",
		"@electron-forge/maker-deb": "7.11.2",
		"@electron-forge/maker-dmg": "7.11.2",
		"@electron-forge/maker-msix": "7.11.2",
		"@electron-forge/maker-zip": "7.11.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.1.1",
		"electron": "42.7.1",
		"eslint": "^10.8.1",
		"globals": "^17.12.0",
		"lucide-react": "^1.17.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"rimraf": "^6.0.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.0"
	},
	"config": {
		"forge": "./forge.config.cjs"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.5.0",
		"@anthropic-ai/claude-agent-sdk": "0.3.276",
		"@cursor/sdk": "1.0.31",
		"@opencode/client": "2.0.22",
		"@phaseo/agent-sdk": "workspace:*",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/xterm": "5.5.0",
		"node-pty": "1.2.0-beta.15",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"unpdf": "1.8.1"
	}
}
