		{
			"id": "billing-unpriced-cache-field",
			"cases": "re:^billing.deepinfra.chat.(stream|buffered).unpriced-cache-field$",
			"description": "A cached-token count the card does not price must still bill the prompt at the input price, never fail accounting.",
			"checks": [
				{
					"path": "client.status",
					"op": "equals",
					"value": 200,
					"kind": "error_mapping",
					"source": {
						"kind": "assumed",
						"reason": "The provider returned a successful completion; a missing price rule for a sub-meter is a Phaseo catalogue gap, not a client error."
					}
				},
				{
					"path": "billing.chargeCount",
					"op": "equals",
					"value": 1,
					"source": {
						"kind": "assumed",
						"reason": "Every successful managed request is charged exactly once."
					},
