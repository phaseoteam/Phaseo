				{
					"path": "billing",
					"op": "billing",
					"value": {
						"meters": {
							"input_text_tokens": 79875,
							"input_image_tokens": 307,
							"input_audio_tokens": 211,
							"cached_read_text_tokens": 20011,
							"output_text_tokens": 5003
						},
						"params": {
							"input_tokens": 100404
						}
					},
					"source": {
						"kind": "docs",
						"url": "https://ai.google.dev/api/generate-content#UsageMetadata",
						"note": "promptTokenCount (100,003; TEXT 99,485 + IMAGE 307 + AUDIO 211) includes cachedContentTokenCount (TEXT 20,011); toolUsePromptTokenCount (401) is extra input; thoughtsTokenCount (1,109) is billed as output with candidatesTokenCount (3,894), per https://cloud.google.com/vertex-ai/generative-ai/pricing."
					}
				}
			]
		},
