					"path": "billing",
					"op": "billing",
					"value": {
						"meters": {
							"input_text_tokens": 79992,
							"cached_read_text_tokens": 20011,
							"output_text_tokens": 5003
						},
						"foldUnpriced": {
							"cached_read_text_tokens": "input_text_tokens"
						}
					},
					"source": {
						"kind": "docs",
						"url": "https://platform.openai.com/docs/api-reference/chat/object",
						"note": "prompt_tokens includes prompt_tokens_details.cached_tokens; with no cached-read rule the cached part is billed at the input price."
					}
				}
			]
		}
