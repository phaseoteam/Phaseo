{
	"group": "billing",
	"description": "Billing end to end for text: one provider per upstream dialect x the three text surfaces x streaming/buffered, fed a usage object with every field the provider documents. Expected cost = catalogue price card applied to the documented usage semantics.",
	"entries": [
		{
			"id": "billing-deepinfra",
			"cases": "re:^billing.deepinfra.(chat|responses|messages).(stream|buffered)$",
			"description": "Charged cost for deepinfra's documented usage, identical on every surface and mode.",
			"checks": [
				{
					"path": "client.status",
					"op": "equals",
					"value": 200,
					"kind": "error_mapping",
					"source": {
						"kind": "assumed",
						"reason": "The provider returned a complete, successful response; the client must receive it."
					}
				},
				{
					"path": "billing.chargeCount",
					"op": "equals",
					"value": 1,
					"source": {
						"kind": "assumed",
						"reason": "Every successful managed request is charged exactly once."
					},
					"kind": "billing_under"
				},
				{
					"path": "billing",
					"op": "billing",
					"value": {
						"meters": {
							"input_text_tokens": 100003,
							"output_text_tokens": 5003
						}
					},
					"source": {
						"kind": "docs",
						"url": "https://deepinfra.com/docs/openai_api",
						"note": "OpenAI-compatible usage: prompt_tokens and completion_tokens; DeepInfra's spec documents no detail objects, so none are sent."
					}
				}
			]
		},
		{
			"id": "billing-openai",
			"cases": "re:^billing.openai.(chat|responses|messages).(stream|buffered)$",
			"description": "Charged cost for openai's documented usage, identical on every surface and mode.",
			"checks": [
				{
					"path": "client.status",
					"op": "equals",
					"value": 200,
					"kind": "error_mapping",
					"source": {
						"kind": "assumed",
						"reason": "The provider returned a complete, successful response; the client must receive it."
					}
				},
				{
					"path": "billing.chargeCount",
					"op": "equals",
					"value": 1,
					"source": {
						"kind": "assumed",
						"reason": "Every successful managed request is charged exactly once."
					},
					"kind": "billing_under"
				},
				{
					"path": "billing",
					"op": "billing",
					"value": {
						"meters": {
							"input_text_tokens": 79992,
							"cached_read_text_tokens": 20011,
							"output_text_tokens": 5003
						}
					},
					"source": {
						"kind": "docs",
						"url": "https://platform.openai.com/docs/api-reference/responses/object",
						"note": "usage.input_tokens includes input_tokens_details.cached_tokens (100,003 = 79,992 uncached + 20,011 cached); output_tokens includes reasoning_tokens."
					}
				}
			]
		},
		{
			"id": "billing-anthropic",
			"cases": "re:^billing.anthropic.(chat|responses|messages).(stream|buffered)$",
