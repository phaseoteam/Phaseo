										{
											"$ref": "#/components/schemas/ImageContent"
										}
									]
								},
								"type": "array"
							}
						],
						"title": "Content"
					},
					"name": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
