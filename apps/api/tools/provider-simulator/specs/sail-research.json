			"RequestMetadata": {
				"type": "object",
				"description": "Optional string metadata. completion_window controls scheduling; completion_webhook/webhook_token configure completion webhooks; supercache_write stores a reusable prompt prefix.",
				"properties": {
					"completion_window": {
						"type": "string",
						"description": "[Completion window](/completion-windows) controls request scheduling and token pricing.\n\n**Defaults when omitted**\n- **Core model inference:** `asap` (low latency).\n- **Batch:** `flex`, including when the value is empty. Other windows are rejected.\n- **LoRA:** `balanced` for core models.\n- **Background Responses:** an available non-ASAP window. Models that only support `asap` are rejected.\n- **Flex-only models:** `flex` is the default and only window, including for Batch and LoRA.\n\n**Requirements**\n- An explicit window must be supported by the model or Sail returns an error. See the [Pricing support matrix](/pricing).\n- Use `flex` through the Batch API or Responses with `background: true`. Synchronous Responses, Chat Completions, and Messages reject `flex`. Background Responses cannot stream.\n\nSee [default behavior](/completion-windows#default-behavior) and [Flex request requirements](/completion-windows#flex) for details.",
						"enum": [
							"asap",
							"balanced",
							"standard",
							"flex"
						]
					},
					"completion_webhook": {
						"type": "string",
						"format": "uri"
					},
					"webhook_token": {
						"type": "string"
					},
					"supercache_write": {
						"type": "string",
						"description": "Write the eligible prompt prefix to Supercache for 24 hours. Supported only by the Responses and Chat Completions APIs. Omit this field for automatic reads.",
						"enum": [
							"24h"
						]
					}
				},
				"additionalProperties": {
					"type": "string"
				}
			},
