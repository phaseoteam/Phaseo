{
	"source": "posthog",
	"fingerprint": "{event.properties.$exception_fingerprint}",
	"title": "{f'{event.properties.$exception_list?.[1]?.type ?? 'Error'} on {event.properties.path ?? event.properties.$pathname ?? 'web'}: {event.properties.$exception_list?.[1]?.value ?? 'Unhandled exception'}'}",
	"severity": "medium",
	"environment": "{event.properties.environment}",
	"source_url": "{notEmpty(event.properties.$exception_issue_id ?? '') ? f'https://eu.posthog.com/project/81404/error_tracking/{event.properties.$exception_issue_id}' : 'https://eu.posthog.com/project/81404/error_tracking'}",
	"replay_url": "{notEmpty(event.properties.$session_id ?? '') ? f'https://eu.posthog.com/project/81404/replay/{event.properties.$session_id}' : null}",
	"release": "{event.properties.release}",
	"route": "{event.properties.path ?? event.properties.$pathname}",
	"exception_type": "{event.properties.$exception_list?.[1]?.type}",
	"exception_message": "{event.properties.$exception_list?.[1]?.value}"
}
