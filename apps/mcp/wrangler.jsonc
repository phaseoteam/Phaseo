{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phaseo-mcp-preview",
  "main": "src/index.ts",
  "build": { "command": "pnpm build:ui" },
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "INFERENCE_RUNS", "class_name": "InferenceRunReceipt" }] },
  "migrations": [{ "tag": "inference-receipts-v1", "new_sqlite_classes": ["InferenceRunReceipt"] }],
  "secrets": {
    "required": ["PHASEO_MCP_RESOURCE_SERVER_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "PHASEO_API_BASE_URL": "https://api.phaseo.app",
    "PHASEO_WEB_BASE_URL": "https://phaseo.app"
  },
  "env": {
    "production": {
      "name": "phaseo-mcp",
      "workers_dev": false,
      "durable_objects": { "bindings": [{ "name": "INFERENCE_RUNS", "class_name": "InferenceRunReceipt" }] },
      "secrets": {
        "required": ["PHASEO_MCP_RESOURCE_SERVER_SECRET"]
      },
      "routes": [
        { "pattern": "mcp.phaseo.app", "custom_domain": true }
      ],
      "services": [
        { "binding": "PHASEO_API", "service": "phaseo-gateway" }
      ],
      "vars": {
        "PHASEO_API_BASE_URL": "https://api.phaseo.app",
        "PHASEO_WEB_BASE_URL": "https://phaseo.app"
      }
    }
  }
}
