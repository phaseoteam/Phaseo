{
  // Experiment only: vinext build of the web app on a workers.dev URL.
  // No routes or custom domains, so phaseo.app is untouched.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phaseo-web-vinext-preview",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "vars": { "HTML_CACHE_TTL": "3600" },
  "workers_dev": true,
  "upload_source_maps": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "html_handling": "none",
    "binding": "ASSETS",
    // Static folders go straight to assets so they cost no Worker requests or CPU.
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*", "!/_i18n/*", "!/_messages/*", "!/_content/*", "!/logos/*"]
  }
}
