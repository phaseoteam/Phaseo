{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {},
		"apps/web": {
			"entry": ["src/routes/**", "src/router.tsx", "src/start.ts", "vite.config.ts"]
		},
		"apps/api": {
			"entry": ["apps/api/src/**/*.ts"]
		},
		"packages/*": {}
	},
	"ignore": [
		"**/dist/**",
		"**/.turbo/**",
		"**/node_modules/**",
		"apps/api/.wrangler/**",
		"apps/web/.wrangler/**",
		"apps/web/.tanstack/**",
		"apps/web/src/routeTree.gen.ts",
		"apps/web/scripts/**"
	],
	"jest": false
}
