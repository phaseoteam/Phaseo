{
  "baseUrl": "https://phaseo.app",
  "tags": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa"],
  "themes": ["light", "dark"],
  "failOn": ["critical", "serious"],
  "pages": [
    { "path": "/", "name": "Home" },
    { "path": "/?auth=sign-in", "name": "Sign-in dialog", "waitFor": "[role=dialog] input[type=email]" },
    { "path": "/?auth=sign-up", "name": "Sign-up dialog", "waitFor": "[role=dialog] input[type=email]" },
    { "path": "/models", "name": "Models list" },
    { "path": "/models/anthropic/claude-fable-5.2", "name": "Model page" },
    { "path": "/compare", "name": "Compare" },
    { "path": "/compare/openrouter", "name": "Gateway comparison" },
    { "path": "/pricing", "name": "Pricing" },
    { "path": "/rankings", "name": "Rankings" },
    { "path": "/organisations", "name": "Organisations" },
    { "path": "/organisations/openai", "name": "Organisation page" },
    { "path": "/api-providers", "name": "Providers" },
    { "path": "/api-providers/openai", "name": "Provider page" },
    { "path": "/api-providers/compare", "name": "Provider comparison (presets)" },
    { "path": "/api-providers/compare?providers=openai&providers=anthropic", "name": "Provider comparison (grid)", "waitFor": "text=Monthly tokens" },
    { "path": "/benchmarks", "name": "Benchmarks" },
    { "path": "/benchmarks/2-bench-retail", "name": "Benchmark page" },
    { "path": "/families", "name": "Model families" },
    { "path": "/subscription-plans", "name": "Subscription plans" },
    { "path": "/subscription-plans/amazon-q-developer-pro", "name": "Subscription plan page" },
    { "path": "/countries", "name": "Countries" },
    { "path": "/performance", "name": "Performance" },
    { "path": "/gateway/marketplace", "name": "Gateway marketplace" },
    { "path": "/updates/models", "name": "Model changelog" },
    { "path": "/updates/calendar", "name": "Release calendar" },
    { "path": "/methodology", "name": "Methodology" },
    { "path": "/how-phaseo-calculates-model-pricing", "name": "Methodology article" },
    { "path": "/blog", "name": "Blog" },
    { "path": "/blog/realtime-voice-in-chat", "name": "Blog post" },
    { "path": "/learn", "name": "Learn" },
    { "path": "/help", "name": "Help centre" },
    { "path": "/help/billing-and-credits", "name": "Help category" },
    { "path": "/help/billing-and-credits/download-invoices", "name": "Help article" },
    { "path": "/tools", "name": "Tools" },
    { "path": "/tools/pricing-calculator", "name": "Pricing calculator" },
    { "path": "/migrate", "name": "Migrate" },
    { "path": "/works-with", "name": "Works with" },
    { "path": "/about", "name": "About" },
    { "path": "/contact", "name": "Contact" },
    { "path": "/faq", "name": "FAQ" },
    { "path": "/trust", "name": "Trust centre" },
    { "path": "/trust/subprocessors", "name": "Subprocessors" },
    { "path": "/terms", "name": "Terms" },
    { "path": "/privacy", "name": "Privacy" },
    { "path": "/docs/v1", "name": "Docs home" },
    { "path": "/docs/v1/quickstart", "name": "Docs quickstart" },
    { "path": "/docs/v1/api-reference/introduction", "name": "API reference" }
  ],
  "exceptions": [
    {
      "rule": "label-content-name-mismatch",
      "pathPrefix": "/docs/",
      "html": "<div class=\"card block font-norm",
      "reason": "Mintlify renders docs cards as role=link named by the card title, which is visible text; axe flags the description text beside it. The markup comes from Mintlify, not this repo."
    }
  ]
}
