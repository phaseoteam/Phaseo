# Copy to .env.local and fill in. .env.local is ignored by git.
# Everything here is read on the server only; none of it reaches the browser.

# From Settings > OAuth Apps in Phaseo.
PHASEO_OAUTH_CLIENT_ID=
# Confidential apps only. Leave empty for a public app.
PHASEO_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth app.
PHASEO_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Encrypts the session cookie. A random string of at least 32 characters.
SESSION_SECRET=

# Optional
PHASEO_API_URL=https://api.phaseo.app
GATEWAY_APP_TITLE=
GATEWAY_HTTP_REFERER=
