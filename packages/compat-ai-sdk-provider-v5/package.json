{
  "name": "@phaseo/ai-sdk-provider",
  "version": "0.5.0",
  "description": "Phaseo Gateway provider for Vercel AI SDK 5",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node ./test/compatibility.mjs",
    "test:release": "npm test && npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "phaseo",
    "gateway",
    "provider"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/provider": "2.0.3",
    "@ai-sdk/openai-compatible": "1.0.52"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "ai": "5.0.249",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "ai": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phaseoteam/Phaseo",
    "directory": "packages/compat-ai-sdk-provider-v5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "ai-sdk-v5"
  },
  "overrides": {
    "undici": "^6.29.1"
  }
