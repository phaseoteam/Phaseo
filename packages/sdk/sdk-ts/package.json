{
	"name": "@phaseo/sdk",
	"description": "Phaseo Gateway SDK for TypeScript/JavaScript",
	"version": "3.0.0",
	"type": "module",
	"private": false,
	"license": "MIT",
	"main": "./dist/cjs/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./testing": {
			"import": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" },
			"require": { "types": "./dist/cjs/testing.d.ts", "default": "./dist/cjs/testing.js" }
		},
		".": {
			"import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
			"require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
		},
		"./devtools": {
			"import": { "types": "./dist/devtools/index.d.ts", "default": "./dist/devtools/index.js" },
			"require": { "types": "./dist/cjs/devtools/index.d.ts", "default": "./dist/cjs/devtools/index.js" }
		},
		"./compat/openai": {
			"import": { "types": "./dist/compat/openai.d.ts", "default": "./dist/compat/openai.js" },
			"require": { "types": "./dist/cjs/compat/openai.d.ts", "default": "./dist/cjs/compat/openai.js" }
		},
		"./compat/anthropic": {
			"import": { "types": "./dist/compat/anthropic.d.ts", "default": "./dist/compat/anthropic.js" },
			"require": { "types": "./dist/cjs/compat/anthropic.d.ts", "default": "./dist/cjs/compat/anthropic.js" }
		}
	},
	"files": [
		"dist",
		"SKILL.md",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"clean": "rimraf dist src/oapi-gen",
		"gen": "pnpm -w oapi:gen:ts",
		"build": "node scripts/build.mjs",
		"prepublishOnly": "pnpm run build",
		"test:unit": "pnpm exec vitest run tests/client-async-jobs.test.ts tests/client-batches.test.ts tests/client-jobs.test.ts tests/client-chat.test.ts tests/client-endpoints.test.ts tests/client-files.test.ts tests/client-health.test.ts tests/client-video.test.ts tests/devtools.test.ts tests/package-metadata.test.ts tests/webhooks.test.ts",
		"test:smoke": "pnpm smoke:all",
		"smoke:chat": "dotenv -e .env.local -- tsx tests/smoke.ts --operation chat",
		"smoke:responses": "dotenv -e .env.local -- tsx tests/smoke.ts --operation responses",
		"smoke:compat-openai": "dotenv -e .env.local -- tsx tests/compat-openai.ts",
		"smoke:compat-anthropic": "dotenv -e .env.local -- tsx tests/compat-anthropic.ts",
		"smoke:all": "pnpm smoke:responses && pnpm smoke:chat && pnpm smoke:compat-openai && pnpm smoke:compat-anthropic",
		"test": "pnpm test:unit && pnpm exec vitest run tests/developer-experience.test.ts",
		"test:package": "pnpm run build && node scripts/test-package.mjs",
		"pack:dry": "npm pack --dry-run"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"rimraf": "^6.0.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phaseoteam/Phaseo.git"
	},
	"publishConfig": {
		"access": "public"
	}
}
