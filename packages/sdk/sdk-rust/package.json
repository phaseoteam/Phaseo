{
  "name": "@phaseo/rust-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Official Rust SDK for Phaseo Gateway",
  "license": "MIT",
  "scripts": {
    "postinstall": "node ../scripts/postinstall-viewer-prompt.cjs @phaseo/rust-sdk",
    "build": "cargo build",
    "test": "cargo test --all-targets",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "package": "cargo package",
    "smoke:chat": "dotenv -e .env.local -- cargo test --test smoke_chat -- --nocapture",
    "smoke:responses": "dotenv -e .env.local -- cargo test --test smoke_responses -- --nocapture"
  }
}
