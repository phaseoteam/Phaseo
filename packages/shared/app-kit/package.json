{
	"name": "@phaseo/app-kit",
	"description": "Plain code shared by Phaseo's apps (website, desktop, mobile, Factory): logos, provider naming, gateway status, benchmark helpers, design tokens, class recipes and display formatters",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"sideEffects": false,
	"exports": {
		"./logos": "./src/logos/index.ts",
		"./provider-offers": "./src/providerOffers.ts",
		"./gateway-status": "./src/providerGatewayStatus.ts",
		"./benchmarks/epoch": "./src/benchmarks/epoch.ts",
		"./theme": "./src/theme/index.ts",
		"./theme/colour": "./src/theme/colour.ts",
		"./ui-recipes": "./src/ui-recipes/index.ts",
		"./format": "./src/format/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.mjs"
	},
	"devDependencies": {
		"@typescript/native": "catalog:",
		"typescript": "catalog:"
	}
}
