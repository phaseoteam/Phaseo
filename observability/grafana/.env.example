# Copy to .env.local (ignored); keep all tokens private.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LOKI_UID=
GRAFANA_USAGE_UID=grafanacloud-usage
GRAFANA_ENVIRONMENT=staging
GRAFANA_FRONTEND_ORIGINS=https://phaseo.app,https://www.phaseo.app

# Backend deployment settings: gateway, web API and website Workers.
PLATFORM_TELEMETRY_ENABLED=false
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-YOUR-REGION.grafana.net/otlp
GRAFANA_OTLP_AUTHORIZATION=
PLATFORM_TRACE_SAMPLE_RATE=0.05
# Gateway/web API use ENV; website uses PHASEO_ENV. Production also accepts prod.
ENV=staging
PHASEO_ENV=staging

# Public browser configuration returned by a server function. No tokens here.
PUBLIC_FARO_ENABLED=false
PUBLIC_FARO_URL=
PUBLIC_FARO_SESSION_SAMPLE_RATE=0.1
# Release is supplied by the build, not a long-lived Infisical secret.
PUBLIC_RELEASE=

# Optional private source-map build/upload.
FARO_SOURCEMAP_ENDPOINT=
FARO_SOURCEMAP_APP_ID=
FARO_SOURCEMAP_STACK_ID=
FARO_SOURCEMAP_API_KEY=

# GitHub Actions secret for private web source maps (never a PUBLIC_* value).
# PostHog personal API key with error_tracking:write and organization:read.
POSTHOG_CLI_API_KEY=
