[
  {
    "uid": "phaseo-gateway-errors-production",
    "title": "Phaseo production · Gateway actionable failures",
    "folderUID": "phaseo-observability",
    "ruleGroup": "phaseo-production",
    "orgID": 1,
    "condition": "B",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": true,
    "labels": {
      "application": "phaseo",
      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "At least 20 requests in 10 minutes and over 5% actionable failures."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 1200,
          "to": 0
        },
        "datasourceUid": "SET_LOKI_DATASOURCE_UID",
        "model": {
          "refId": "A",
          "expr": "(((sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", actionable=\"actionable\" | __error__=\"\" | environment=\"production\" | event_name=\"gateway.request\" | actionable=\"true\" | __error__=\"\" [10m])) or vector(0)) / (sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"production\" | event_name=\"gateway.request\" | __error__=\"\" [10m])) or vector(0))) > 0.05) and ((sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"production\" | event_name=\"gateway.request\" | __error__=\"\" [10m])) or vector(0)) >= 20)",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "loki",
            "uid": "SET_LOKI_DATASOURCE_UID"
          },
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "math",
          "expression": "$A > 0",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ]
  },
  {
    "uid": "phaseo-scheduler-missing-production",
    "title": "Phaseo production · Scheduler telemetry missing",
    "folderUID": "phaseo-observability",
    "ruleGroup": "phaseo-production",
    "orgID": 1,
    "condition": "B",
    "for": "5m",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": true,
    "labels": {
      "application": "phaseo",
      "environment": "production",
      "severity": "warning"
    },
    "annotations": {
      "summary": "No scheduler heartbeat for 15 minutes. Check cron, bindings and Grafana delivery; quiet user traffic does not cause this alert."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 1200,
          "to": 0
        },
        "datasourceUid": "SET_LOKI_DATASOURCE_UID",
        "model": {
          "refId": "A",
          "expr": "absent_over_time({service_name=~\"phaseo-jobs\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"production\" | event_name=\"job.heartbeat\" [15m]) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "loki",
            "uid": "SET_LOKI_DATASOURCE_UID"
          },
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "math",
          "expression": "$A > 0",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ]
  },
