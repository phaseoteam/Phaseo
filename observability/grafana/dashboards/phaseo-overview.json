{
  "uid": "phaseo-overview",
  "title": "Phaseo · Overview",
  "description": "Check received traffic and failures, then investigate the affected service. Scheduler freshness is not an external uptime check.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "phaseo",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Gateway",
      "type": "link",
      "url": "/d/phaseo-gateway?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Web",
      "type": "link",
      "url": "/d/phaseo-web?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Jobs",
      "type": "link",
      "url": "/d/phaseo-jobs?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Telemetry",
      "type": "link",
      "url": "/d/phaseo-telemetry?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Explore",
      "type": "link",
      "url": "/explore"
    },
    {
      "title": "Frontend Observability",
      "type": "link",
      "url": "/a/grafana-kowalski-app"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      },
      {
        "name": "request",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "title": "Start here",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "**1. Check collection:** “Arriving” means a scheduler heartbeat was received in the last 5 minutes. “Missing” means check cron and telemetry delivery. **2. Check failures:** red counts need investigation; click a count to open its service dashboard. **3. Compare the charts:** did failures or latency rise after a deployment?\n\nCounts cover the selected time range and received events only. Zero requests can mean quiet traffic; zero failures does not prove uptime. Use external checks to establish availability and alert rules to configure notifications."
      }
    },
    {
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "title": "Scheduler telemetry · last 5m",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "At least one recent heartbeat confirms scheduler telemetry is arriving. This does not test the website or generation endpoints from outside Cloudflare.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-jobs\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"job.heartbeat\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "Missing",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000,
                "result": {
                  "text": "Arriving",
                  "color": "green"
                }
              }
            }
          ],
          "links": [
            {
              "title": "Investigate",
              "url": "/d/phaseo-telemetry?var-environment=$environment&from=$__from&to=$__to"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "title": "Gateway requests",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Received terminal gateway request events in the selected time range. Includes success, error and cancellation; not a billing count.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | __error__=\"\" [$__range])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Investigate",
              "url": "/d/phaseo-gateway?var-environment=$environment&from=$__from&to=$__to"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "title": "Gateway failures",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Actionable logical request failures, including failures after streaming HTTP 200. Client cancellations are excluded.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", actionable=\"actionable\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | actionable=\"true\" | __error__=\"\" [$__range])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Investigate",
              "url": "/d/phaseo-gateway?var-environment=$environment&from=$__from&to=$__to"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "title": "Web API requests",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Web API response-header events in the selected time range. This is separate from gateway generation traffic.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.request\" | __error__=\"\" [$__range])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Investigate",
              "url": "/d/phaseo-web?var-environment=$environment&from=$__from&to=$__to"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "title": "Web API 5xx",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Server-error responses only. Expected client rejections such as 401 and 404 are excluded.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", status_code=\"status_code\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.request\" | status_code >= 500 | __error__=\"\" [$__range])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Investigate",
              "url": "/d/phaseo-web?var-environment=$environment&from=$__from&to=$__to"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "title": "Job failures",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Job invocations that threw or explicitly reported known item failures. A completed handler can still contain internally handled failures.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-jobs|phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"job.run\" | outcome=\"error\" | __error__=\"\" [$__range])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Investigate",
              "url": "/d/phaseo-jobs?var-environment=$environment&from=$__from&to=$__to"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "title": "Traffic · rolling 5 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Each point counts events received in the preceding 5 minutes. Web API and gateway are separate traffic populations; do not add them as unique requests.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Gateway"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=~\"phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.request\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Web API"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "title": "Failures · rolling 5 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Received failure events per category, not distinct incidents. One incident can produce events in multiple categories.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", actionable=\"actionable\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | actionable=\"true\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Gateway actionable"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=~\"phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", status_code=\"status_code\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.request\" | status_code >= 500 | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Web API 5xx"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({service_name=~\"phaseo-web\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.server_error\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Website server errors"
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({service_name=~\"phaseo-jobs|phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"job.run\" | outcome=\"error\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Job failures"
        },
        {
          "refId": "E",
          "expr": "sum(count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"ops.failure\" | __error__=\"\" [5m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "Operational failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "title": "Gateway p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "95% of received terminal gateway timings are at or below this value. Includes streamed response completion. Interpret with request volume; a percentile from very few requests is unstable. Missing timing stays empty.",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", duration_ms=\"duration_ms\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | unwrap duration_ms | __error__=\"\" [$__auto]) by (service_name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "title": "Web API p95 headers",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "95% of received web API timings reach response headers within this duration. Does not measure full streamed response completion. Empty means no matching timings, not zero latency.",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", duration_ms=\"duration_ms\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.request\" | unwrap duration_ms | __error__=\"\" [$__auto]) by (service_name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "title": "Gateway outcomes",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Counts in the selected time range. Cancellation is separate from success and error; error is not always operationally actionable.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | __error__=\"\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No matching events",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
