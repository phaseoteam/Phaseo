{
  "uid": "phaseo-overview",
  "title": "Phaseo · Overview",
  "description": "Start here. Quiet traffic is normal; the scheduler heartbeat provides independent telemetry freshness.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "phaseo",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Gateway",
      "type": "link",
      "url": "/d/phaseo-gateway?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Web",
      "type": "link",
      "url": "/d/phaseo-web?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Jobs",
      "type": "link",
      "url": "/d/phaseo-jobs?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Telemetry",
      "type": "link",
      "url": "/d/phaseo-telemetry?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Explore",
      "type": "link",
      "url": "/explore"
    },
    {
      "title": "Frontend Observability",
      "type": "link",
      "url": "/a/grafana-kowalski-app"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      },
      {
        "name": "request",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "title": "Gateway requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | __error__=\"\" [$__auto])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "title": "Actionable failures / second",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Logical request failures classified as actionable. Client cancellations are excluded.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", actionable=\"actionable\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | actionable=\"true\" | __error__=\"\" [$__auto])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "title": "Gateway p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Terminal request duration, including streamed responses. Missing timing is omitted.",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", duration_ms=\"duration_ms\" | __error__=\"\" | environment=\"$environment\" | event_name=\"gateway.request\" | unwrap duration_ms | __error__=\"\" [$__auto])",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "title": "Web API p95 headers",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Time to response headers; streamed generation completion is measured by the gateway.",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", duration_ms=\"duration_ms\" | __error__=\"\" | environment=\"$environment\" | event_name=\"web.request\" | unwrap duration_ms | __error__=\"\" [$__auto])",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "title": "Scheduler ticks / 15 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Expected about 15 ticks. Zero means missing scheduler or missing telemetry, even if there are no users.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"phaseo-jobs\"} | json environment=\"environment\", event_name=\"event_name\" | __error__=\"\" | environment=\"$environment\" | event_name=\"job.heartbeat\" | __error__=\"\" [15m])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "title": "Recent actionable events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"phaseo-.*\"} | json environment=\"environment\", event_name=\"event_name\", actionable=\"actionable\" | __error__=\"\" | environment=\"$environment\" | actionable=\"true\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
