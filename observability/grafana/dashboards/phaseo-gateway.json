{
  "uid": "phaseo-gateway",
  "title": "Phaseo · Gateway and providers",
  "description": "Request summaries cover received terminal events. Trace retention is sampled. Delivery is best effort, so counts are operational rather than financial.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "phaseo",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/phaseo-overview?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Web",
      "type": "link",
      "url": "/d/phaseo-web?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Jobs",
      "type": "link",
      "url": "/d/phaseo-jobs?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Telemetry",
      "type": "link",
      "url": "/d/phaseo-telemetry?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Explore",
      "type": "link",
      "url": "/explore"
    },
    {
      "title": "Frontend Observability",
      "type": "link",
      "url": "/a/grafana-kowalski-app"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      },
      {
        "name": "request",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 2
      },
      {
        "name": "provider",
        "label": "Provider contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "model",
        "label": "Model contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "title": "Requests by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", outcome=\"outcome\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"gateway.request\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "title": "Provider attempts / second",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (rate({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", outcome=\"outcome\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"provider.attempt\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{provider}} · {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "title": "Streaming p95 time to first token",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Downstream first token timing. Null timings are omitted, never converted into zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", ttft_ms=\"ttft_ms\", stream=\"stream\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"gateway.request\" | stream=\"true\" | unwrap ttft_ms | __error__=\"\" [$__auto]) by (service_name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "title": "Provider p95 first token",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider_ttft_ms=\"provider_ttft_ms\", stream=\"stream\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"gateway.request\" | stream=\"true\" | unwrap provider_ttft_ms | __error__=\"\" [$__auto]) by (service_name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 9
      },
      "title": "Requests requiring fallback / second",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", attempt_count=\"attempt_count\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"gateway.request\" | attempt_count > 1 | __error__=\"\" [$__auto])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 9
      },
      "title": "Client cancellations / second",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", outcome=\"outcome\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"gateway.request\" | outcome=\"cancelled\" | __error__=\"\" [$__auto])) or vector(0)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 12,
        "h": 9
      },
      "title": "Request lookup",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Enter a request ID above. Expand the JSON line to find trace_id; paste it into Tempo in Explore. Only sampled traces exist.",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", request_id=\"request_id\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"gateway.request\" | request_id=~\"${request:regex}.*\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 54,
        "w": 12,
        "h": 9
      },
      "title": "Provider attempt lookup",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", request_id=\"request_id\", provider=\"provider\", model=\"model\" | __error__=\"\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | environment=\"$environment\" | event_name=\"provider.attempt\" | request_id=~\"${request:regex}.*\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Provider and model attempts",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Selected-range received events. Up to 10 failing and 10 busiest groups; sorted by failures. Failure % uses the displayed attempts population. p95 uses available timings; sparse samples are unstable. A dash means unavailable, not zero. Attempt failures can recover through fallback. Model is the provider model slug; stealth attempts are excluded.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "label_replace(((sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range]))) and on (provider, model) (topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | outcome=\"error\" | __error__=\"\" [$__range]))) or topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range]))))), \"measure\", \"Attempts\", \"\", \"\") or label_replace(((((sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | outcome=\"error\" | __error__=\"\" [$__range]))) or (0 * (sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range])))))) and on (provider, model) (topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | outcome=\"error\" | __error__=\"\" [$__range]))) or topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range]))))), \"measure\", \"Failures\", \"\", \"\") or label_replace(((100 * ((sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | outcome=\"error\" | __error__=\"\" [$__range]))) or (0 * (sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range]))))) / (sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range])))) and on (provider, model) (topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | outcome=\"error\" | __error__=\"\" [$__range]))) or topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range]))))), \"measure\", \"Failure %\", \"\", \"\") or label_replace(((quantile_over_time(0.95, {service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\", duration_ms=\"duration_ms\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | unwrap duration_ms | __error__=\"\" [$__range]) by (provider, model)) and on (provider, model) (topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | outcome=\"error\" | __error__=\"\" [$__range]))) or topk(10, sum by (provider, model) (count_over_time({service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", provider=\"provider\", model=\"model\", outcome=\"outcome\" | __error__=\"\" | environment=\"$environment\" | event_name=\"provider.attempt\" | provider=~\".*${provider:regex}.*\" | model=~\".*${model:regex}.*\" | __error__=\"\" [$__range]))))), \"measure\", \"p95 ms\", \"\", \"\")"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "measure"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "provider": 0,
              "model": 1,
              "Attempts": 2,
              "Failures": 3,
              "Failure %": 4,
              "p95 ms": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Failures",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—",
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "provider"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Provider"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "model"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Model"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failure %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "model"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate",
                    "url": "/d/phaseo-gateway?var-environment=$environment&from=$__from&to=$__to&var-model=${__data.fields[\"model\"]}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      }
    },
    {
      "title": "Gateway failure reasons",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Logical request failures grouped by classification, including non-actionable client rejections. Cancellations are excluded. Attempt failures can recover through fallback.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
