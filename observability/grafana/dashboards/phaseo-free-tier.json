    {
      "id": 17,
      "title": "Ingestion pace",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Logs · 31-day pace estimate",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "description": "Estimate only: mean received bytes/second over available samples in the preceding 24 hours × 31 days ÷ 1e9. Conservative month length; not a forecast or month-to-date usage. Includes all visible stacks. Short or interrupted history can bias the estimate. Ingestion may differ from billable usage after credits, filtering or query charges.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(avg_over_time(grafanacloud_logs_instance_bytes_received_per_second[24h])) * 2678400 / 1e9",
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "instant": true,
          "range": false,
          "legendFormat": "Logs · 31-day pace estimate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: GB",
          "decimals": 2,
          "min": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 32
        },
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
