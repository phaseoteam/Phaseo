    {
      "id": 15,
      "title": "Trace spans received · per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "description": "Grafana supplied five-minute span ingestion rate; already a rate, do not apply rate() again. This is the sampled span population, not total requests.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stack_id) (grafanacloud_traces_instance_spans_received_total:rate5m)",
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
