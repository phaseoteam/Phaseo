{
  "uid": "phaseo-free-tier",
  "title": "Phaseo · Free tier",
  "description": "Permanent Free allowances, current billable usage, ingestion pace and collection gaps. Organization-wide, with missing data preserved.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "phaseo",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/phaseo-overview"
    },
    {
      "title": "Telemetry health",
      "type": "link",
      "url": "/d/phaseo-telemetry"
    },
    {
      "title": "Billing/Usage",
      "type": "link",
      "url": "/dashboards?query=Billing%2FUsage"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "usage",
        "label": "Cloud usage",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^grafanacloud-usage$/",
        "refresh": 1,
        "current": {
          "text": "grafanacloud-usage",
          "value": "grafanacloud-usage"
        },
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Free allowances",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Organization-wide monthly usage against **permanent Free allowances**. Amber: 80%. Red: 100%. Missing data stays **Unavailable**. These bars do not cap collection. Free includes 14-day metrics/logs/traces retention and 3 active Grafana users. [Billing/Usage](/dashboards?query=Billing%2FUsage) · [Account plan](https://grafana.com/profile/org)"
      }
    },
    {
      "id": 2,
      "title": "Metric series / 10,000",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "description": "Organization-wide, across all stacks and environments. Grafana-reported current monthly billable usage, matching Billing/Usage. Not an invoice or a counter to increase(); delayed updates and fractional estimates are possible. The dashboard time range does not reset the billing period. Missing data stays unavailable. Permanent Free allowance: 10,000. Billable series account for both active series and data points per minute.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafanacloud_org_metrics_billable_series)",
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "instant": true,
          "range": false,
          "legendFormat": "Metric series / 10,000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 8000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "max": 10000
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "sizing": "manual",
        "minVizHeight": 24,
        "maxVizHeight": 32,
        "text": {
          "valueSize": 20
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Logs / 50 GB",
      "type": "bargauge",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "description": "Organization-wide, across all stacks and environments. Grafana-reported current monthly billable usage, matching Billing/Usage. Not an invoice or a counter to increase(); delayed updates and fractional estimates are possible. The dashboard time range does not reset the billing period. Missing data stays unavailable. Permanent Free allowance: 50. Includes Grafana billable log usage; query overage may also contribute on older billing models.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafanacloud_org_logs_usage)",
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
