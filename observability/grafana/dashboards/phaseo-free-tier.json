{
  "uid": "phaseo-free-tier",
  "title": "Phaseo · Free tier",
  "description": "Permanent Free allowances, current billable usage, ingestion pace and collection gaps. Organization-wide, with missing data preserved.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "phaseo",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/phaseo-overview"
    },
    {
      "title": "Telemetry health",
      "type": "link",
      "url": "/d/phaseo-telemetry"
    },
    {
      "title": "Billing/Usage",
      "type": "link",
      "url": "/dashboards?query=Billing%2FUsage"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "usage",
        "label": "Cloud usage",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^grafanacloud-usage$/",
        "refresh": 1,
        "current": {
          "text": "grafanacloud-usage",
          "value": "grafanacloud-usage"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Stay on Free",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Permanent Free budgets:** 10,000 metric series, 50 GB logs, 50 GB traces, 50,000 browser sessions, 100,000 API checks and 10,000 browser checks per month. Metrics, logs and traces retain 14 days. Grafana and IRM each allow 3 active users. [Current pricing](https://grafana.com/pricing/).\n\nYellow means 80% of an allowance; red means 100%. These are visibility thresholds, not ingestion caps or notifications. A trial can expose higher limits. Keep the account on Free; check the account plan and trial end in [Cloud Portal](https://grafana.com/profile/org). No data means unavailable, not unused. Usage is organization-wide, without environment filters."
      }
    },
    {
      "id": 2,
      "title": "Metric series / 10,000",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "description": "Organization-wide, across all stacks and environments. Grafana-reported current monthly billable usage, matching Billing/Usage. Not an invoice or a counter to increase(); delayed updates and fractional estimates are possible. The dashboard time range does not reset the billing period. Missing data stays unavailable. Permanent Free allowance: 10,000. Billable series account for both active series and data points per minute.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafanacloud_org_metrics_billable_series)",
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
          },
          "instant": true,
          "range": false,
          "legendFormat": "Metric series / 10,000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 8000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Logs / 50 GB",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${usage}"
      },
      "description": "Organization-wide, across all stacks and environments. Grafana-reported current monthly billable usage, matching Billing/Usage. Not an invoice or a counter to increase(); delayed updates and fractional estimates are possible. The dashboard time range does not reset the billing period. Missing data stays unavailable. Permanent Free allowance: 50. Includes Grafana billable log usage; query overage may also contribute on older billing models.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(grafanacloud_org_logs_usage)",
          "datasource": {
            "type": "prometheus",
            "uid": "${usage}"
