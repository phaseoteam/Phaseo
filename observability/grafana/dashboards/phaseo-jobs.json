{
  "uid": "phaseo-jobs",
  "title": "Phaseo · Jobs and settlement",
  "description": "Completion means the handler returned; inspect item failures separately. Skipped jobs are distinct. Financial truth remains in Supabase.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "phaseo",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/phaseo-overview?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Gateway",
      "type": "link",
      "url": "/d/phaseo-gateway?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Web",
      "type": "link",
      "url": "/d/phaseo-web?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Telemetry",
      "type": "link",
      "url": "/d/phaseo-telemetry?var-environment=$environment",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Free tier",
      "type": "link",
      "url": "/d/phaseo-free-tier"
    },
    {
      "title": "Explore",
      "type": "link",
      "url": "/explore"
    },
    {
      "title": "Frontend Observability",
      "type": "link",
      "url": "/a/grafana-kowalski-app"
    },
    {
      "title": "Alerts",
      "type": "link",
      "url": "/alerting/list"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      },
      {
        "name": "request",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 2
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1,
        "hide": 2
      },
      {
        "name": "job",
        "label": "Job contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "title": "Completed job invocations",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (count_over_time({service_name=~\"phaseo-jobs|phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", job=\"job\", outcome=\"outcome\" | __error__=\"\" | job=~\".*${job:regex}.*\" | environment=\"$environment\" | event_name=\"job.run\" | outcome=\"completed\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "title": "Failed job invocations",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (count_over_time({service_name=~\"phaseo-jobs|phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", job=\"job\", outcome=\"outcome\" | __error__=\"\" | job=~\".*${job:regex}.*\" | environment=\"$environment\" | event_name=\"job.run\" | outcome=\"error\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "title": "Job p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=~\"phaseo-jobs|phaseo-web-api\"} | json environment=\"environment\", event_name=\"event_name\", duration_ms=\"duration_ms\", job=\"job\" | __error__=\"\" | job=~\".*${job:regex}.*\" | environment=\"$environment\" | event_name=\"job.run\" | unwrap duration_ms | __error__=\"\" [$__auto]) by (job)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "title": "Disabled job invocations",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (count_over_time({service_name=~\"phaseo-jobs\"} | json environment=\"environment\", event_name=\"event_name\", job=\"job\", outcome=\"outcome\" | __error__=\"\" | job=~\".*${job:regex}.*\" | environment=\"$environment\" | event_name=\"job.run\" | outcome=\"skipped\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "title": "Operational failures",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Newest 100 existing settlement and usage persistence failures. Inspect the source hook and request before taking action. No balances, prompts or customer identities are exported.",
      "links": [
        {
          "title": "Inspect matching logs",
          "url": "/explore?schemaVersion=1&panes=%7B%22investigate%22%3A%7B%22datasource%22%3A%22${loki}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bservice_name%3D~%5C%22phaseo-gateway%5C%22%7D%20%7C%20json%20environment%3D%5C%22environment%5C%22%2C%20event_name%3D%5C%22event_name%5C%22%2C%20job%3D%5C%22job%5C%22%20%7C%20__error__%3D%5C%22%5C%22%20%7C%20job%3D~%5C%22.*${job:regex}.*%5C%22%20%7C%20environment%3D%5C%22$environment%5C%22%20%7C%20event_name%3D%5C%22ops.failure%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22maxLines%22%3A100%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"phaseo-gateway\"} | json environment=\"environment\", event_name=\"event_name\", job=\"job\" | __error__=\"\" | job=~\".*${job:regex}.*\" | environment=\"$environment\" | event_name=\"ops.failure\"",
          "queryType": "range",
          "instant": false,
          "range": true,
          "maxLines": 100,
          "direction": "backward"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Line",
                "service_name",
                "service_version"
              ]
            }
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "timestamp",
                "signal",
                "outcome",
                "error_kind",
                "error_code",
                "request_id",
                "trace_id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "timestamp": 0,
              "signal": 1,
              "outcome": 2,
              "error_kind": 3,
              "error_code": 4,
              "request_id": 5,
              "trace_id": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "timestamp",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "timestamp"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time (UTC)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "signal"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "outcome"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Outcome"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_kind"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Category"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_code"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Code"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "request_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Request ID"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ttft_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "provider_ttft_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "outcome"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "Succeeded"
                      },
                      "error": {
                        "text": "Failed"
                      },
                      "completed": {
                        "text": "Completed"
                      },
                      "skipped": {
                        "text": "Skipped"
                      },
                      "cancelled": {
                        "text": "Cancelled"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "scheduled_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_stack"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 480
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "request_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate",
                    "url": "/d/phaseo-gateway?var-environment=$environment&from=$__from&to=$__to&var-request=${__data.fields[\"request_id\"]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/explore?schemaVersion=1&panes=%7B%22investigate%22%3A%7B%22datasource%22%3A%22${tempo}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceId%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
