# Local single-node defaults. Production must use its real hostname, TLS proxy,
# mail server, secret manager, backup destination, and restricted Git credentials.
WEBLATE_PORT=8080
WEBLATE_DEBUG=0
WEBLATE_LOGLEVEL=INFO
WEBLATE_SITE_TITLE=Phaseo Localisation
WEBLATE_SITE_DOMAIN=localhost:8080
WEBLATE_ALLOWED_HOSTS=localhost,127.0.0.1
WEBLATE_ENABLE_HTTPS=0
WEBLATE_REGISTRATION_OPEN=0
WEBLATE_REQUIRE_LOGIN=1
WEBLATE_ADMIN_NAME=Phaseo Localisation Admin
WEBLATE_ADMIN_EMAIL=localisation@phaseo.app
WEBLATE_SERVER_EMAIL=localisation@phaseo.app
WEBLATE_DEFAULT_FROM_EMAIL=localisation@phaseo.app
WEBLATE_TIME_ZONE=Europe/London
WEBLATE_EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend

POSTGRES_USER=weblate
POSTGRES_DB=weblate
POSTGRES_DATABASE=weblate
POSTGRES_HOST=database
POSTGRES_PORT=5432

REDIS_HOST=cache
REDIS_PORT=6379
CELERY_SINGLE_PROCESS=1
CLIENT_MAX_BODY_SIZE=50M
